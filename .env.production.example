# Production .env — copy to .env on the VPS (never commit .env)

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-long-random-string-here
DJANGO_ALLOWED_HOSTS=deepfake.softheight.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://deepfake.softheight.com,http://deepfake.softheight.com

DB_NAME=deepfake
DB_USER=deepfake_user
DB_PASSWORD=strong-password-here
DB_HOST=127.0.0.1
DB_PORT=3306

# Linux VPS (default): system exiftool from apt install libimage-exiftool-perl
# EXIFTOOL_PATH=/usr/bin/exiftool

# ML — use Keras 3 (do NOT set TF_USE_LEGACY_KERAS=1)
TF_CPP_MIN_LOG_LEVEL=2
TF_ENABLE_ONEDNN_OPTS=0
