# Copy to .env and adjust (never commit .env)
# False on VPS (production). True only if you installed requirements-dev.txt
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=deepfake
DB_USER=root
DB_PASSWORD=admin
DB_HOST=127.0.0.1
DB_PORT=3306

# Linux: leave unset to use system `exiftool` from PATH
# Windows: defaults to deepFake/mlModel/exiftool.exe
# EXIFTOOL_PATH=/usr/bin/exiftool
